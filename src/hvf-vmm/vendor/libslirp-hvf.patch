+/* HVF: the socket authority hands out a bounded pool of UDP proxies. A stub
+ * resolver uses a fresh source port per query, and each answered mapping still
+ * holds its proxy for SO_EXPIREFAST, so under high rotation the pool is full of
+ * mappings that have nothing left to carry and the next query is refused - the
+ * guest then reports a resolution timeout. Retire one such mapping instead.
+ * Only answered DNS mappings qualify: so_expire is shortened exclusively when a
+ * reply arrives and sosendto() restores the long timeout, so this excludes
+ * pending queries, and host forwards and listeners keep no expiry at all. */
+static bool udp_reclaim(Slirp *slirp)
+{
+    struct socket *so, *oldest = NULL;
+
+    for (so = slirp->udb.so_next; so != &slirp->udb; so = so->so_next) {
+        if (so->so_state & SS_HOSTFWD) {
+            continue;
+        }
+        if (so->so_expire == 0 || so->so_expire > curtime + SO_EXPIREFAST) {
+            continue;
+        }
+        /* so_m is only the ICMP backup copy of the last datagram sent, which
+         * sofree() releases; so_queued counts frames still awaiting output. */
+        if (so->so_fport != htons(53) || so->so_queued) {
+            continue;
+        }
+        if (oldest == NULL || so->so_expire < oldest->so_expire) {
+            oldest = so;
+        }
+    }
+    if (oldest == NULL) {
+        return false;
+    }
+    DEBUG_MISC(" udp_reclaim: retiring answered DNS mapping early");
+    udp_detach(oldest);
+    return true;
 }
 
